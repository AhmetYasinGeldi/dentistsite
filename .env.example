# Bu dosyayı .env.local olarak kopyalayın ve değerleri Ahmet'ten alın.
# .env.local ASLA commit'lenmez, kimseyle açık kanalda paylaşılmaz.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # sadece sunucu! tarayıcıya asla gitmez

# WhatsApp Cloud API (sadece sunucu)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=

# Gemini (sadece sunucu)
GEMINI_API_KEY=
GEMINI_MODEL=

# Tanıtım sitesindeki WhatsApp butonu (başında + olmadan, örn. 15551234567)
NEXT_PUBLIC_WHATSAPP_NUMBER=
